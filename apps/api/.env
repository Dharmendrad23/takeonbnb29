# ===========================
# APP
# ===========================
NODE_ENV=production

# Render automatically sets PORT
# Do not add PORT

# ===========================
# CORS
# ===========================
CORS_ORIGIN=https://takeonbnb.com,https://www.takeonbnb.com

# ===========================
# MongoDB
# ===========================
MONGODB_URI=mongodb+srv://takeonbnb_db_user:YOUR_PASSWORD@takeonbnb.hi2dxeq.mongodb.net/takeonbnb?retryWrites=true&w=majority&appName=Takeonbnb

# ===========================
# JWT
# ===========================
JWT_SECRET=YOUR_LONG_RANDOM_SECRET

# ===========================
# SMTP
# ===========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-takeonbnb@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=your-takeonbnb@gmail.com

# ===========================
# Stripe
# ===========================
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY