{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/api\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\"",
    "start": "npm run start --prefix apps/api",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\" \"npm run lint --prefix apps/api\""
  },
  "devDependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "concurrently": "^10.0.3"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "nodemailer": "^9.0.3",
    "react-leaflet": "^4.2.1",
    "swiper": "^14.0.7"
  }
}
